# Copiez ce fichier vers .env puis renseignez les valeurs.

# Local SQLite : DATABASE_URL="file:./prisma/dev.db"
# Neon / Postgres : DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Neon (recommandé si prisma migrate deploy échoue au build avec le pooler) :
# connexion « direct » / sans pooler depuis le dashboard Neon — même base que DATABASE_URL.
# Sinon le script build peut dériver automatiquement l’URL (hostname sans « -pooler », sans ?pgbouncer=… ; channel_binding retiré pour migrate).
# Laisser vide en local si vous n’utilisez pas le pooler pour DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="changez-moi-minimum-32-caracteres-en-production"
AUTH_URL="http://localhost:3000"
# URL publique de l’app (succès / annulation Stripe). En prod : https://votredomaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Déploiement Vercel ---
# Projet Git : définir « Root Directory » = web (Import GitHub → Settings → General).
# Variables à copier depuis ce fichier dans Vercel → Settings → Environment Variables.
# DATABASE_URL : PostgreSQL (Neon, Supabase, etc.) — pas de fichier SQLite file:./... en prod.
# Neon sur Vercel (évite P1001 au build) :
#   DATABASE_URL = onglet Neon « Connection string » → Pooled (souvent hostname …-pooler…neon.tech)
#   DIRECT_URL   = même base → Direct (sans -pooler) — utilisé pour prisma migrate deploy
#   Pas de guillemets autour des valeurs dans Vercel. sslmode=require recommandé.
#   Si le build échoue encore : réveiller le projet Neon (ouvrir le dashboard), puis Redeploy.
# AUTH_URL et NEXT_PUBLIC_APP_URL : https://votre-app.vercel.app (ou votre domaine).
# Build sur Vercel : migrate deploy + création auto des comptes démo si la base est vide (scripts/build-production.mjs + scripts/ensure-demo-users.mjs).
# SKIP_DB_ON_BUILD=1 → uniquement next build (sans migrate / sans démo).
# SKIP_PRISMA_MIGRATE_ON_BUILD=1 → next build + démo, mais sans prisma migrate deploy (migrations déjà appliquées ou à faire hors build).

# Prestataire inscription élève : lemonsqueezy (défaut), paddle ou stripe
# PAYMENT_PROVIDER=lemonsqueezy

# Lemon Squeezy — https://docs.lemonsqueezy.com
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# Secret webhook (Signing secret dans Lemon → Settings → Webhooks)
# LEMONSQUEEZY_WEBHOOK_SECRET=
# true en test / sandbox Lemon
# LEMONSQUEEZY_TEST_MODE=true
# Un variant par offre (prix et quotas affichés : src/lib/plans.ts) :
# LEMONSQUEEZY_VARIANT_ID_PARTICULIER=
# LEMONSQUEEZY_VARIANT_ID_PROF=      (obligatoire pour vendre l'offre Prof)
# LEMONSQUEEZY_VARIANT_ID_CENTRE=    (obligatoire pour vendre l'offre Centre)
# Replis acceptés pour Particulier uniquement :
# LEMONSQUEEZY_VARIANT_ID_ELEVE_AI_PLUS=
# LEMONSQUEEZY_VARIANT_ID_ELEVE_INSCRIPTION=
# Ancienne offre Essentiel (abonnés existants) :
# LEMONSQUEEZY_VARIANT_ID_ELEVE_ESSENTIAL=
# (déprécié) LEMONSQUEEZY_VARIANT_ID_ELEVE_BAC_PLUS= — repli temporaire pour AI Plus
# (déprécié) LEMONSQUEEZY_VARIANT_ID_ELEVE_FAMILY=
# Montant de repli affiché (unité principale, ex. 39 = 39,00) si l’API ne renvoie pas le total
# LEMONSQUEEZY_ELEVE_INSCRIPTION_AMOUNT=39
# URL webhook à déclarer dans Lemon Squeezy : https://votredomaine.com/api/webhooks/lemon-squeezy
# Événement : order_created

# Paddle Billing — alternative (PAYMENT_PROVIDER=paddle)
# PADDLE_API_KEY=
# Secret notifications (signature webhook)
# PADDLE_WEBHOOK_SECRET_KEY=
# sandbox | production — défaut sandbox si absent
# PADDLE_ENVIRONMENT=sandbox
# Prix catalogue Paddle (`pri_…`) recommandé ; sinon prix hors catalogue :
# Un prix par offre — Prof et Centre n'ont aucun repli :
# PADDLE_PRICE_ID_PARTICULIER=
# PADDLE_PRICE_ID_PROF=
# PADDLE_PRICE_ID_CENTRE=
# Replis Particulier : PADDLE_PRICE_ID_ELEVE_AI_PLUS, PADDLE_PRICE_ID_ELEVE_INSCRIPTION
# PADDLE_PRICE_ID_ELEVE_ESSENTIAL=
# (déprécié) PADDLE_PRICE_ID_ELEVE_BAC_PLUS=
# (déprécié) PADDLE_PRICE_ID_ELEVE_FAMILY=
# Montant en plus petite unité (comme Stripe : 3900 = 39,00)
# PADDLE_ELEVE_INSCRIPTION_AMOUNT=3900
# Si prix hors catalogue uniquement — devise SDK (liste Paddle ; sinon créez un Price dans le dashboard)
# PADDLE_CHECKOUT_CURRENCY=EUR
# URL webhook à déclarer dans Paddle : https://votredomaine.com/api/webhooks/paddle
# Si l'API renvoie une erreur au checkout : définir aussi un « default payment link »
# dans Paddle → Checkout settings, et approuver le domaine du site pour les URLs de retour.

# Stripe — inscription élève (Checkout) — prestataire par défaut
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook : checkout.session.completed — https://dashboard.stripe.com/webhooks
# URL : https://votredomaine.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Un Price ID par offre — Prof et Centre n'ont aucun repli :
# STRIPE_PRICE_ID_PARTICULIER=
# STRIPE_PRICE_ID_PROF=
# STRIPE_PRICE_ID_CENTRE=
# Replis Particulier : STRIPE_PRICE_ID_ELEVE_AI_PLUS, STRIPE_PRICE_ID_ELEVE_INSCRIPTION
STRIPE_PRICE_ID_ELEVE_INSCRIPTION=
# STRIPE_PRICE_ID_ELEVE_ESSENTIAL=
# (déprécié) STRIPE_PRICE_ID_ELEVE_BAC_PLUS=
# (déprécié) STRIPE_PRICE_ID_ELEVE_FAMILY=
# Montant en centimes MAD si pas de Price ID (3900 = 39,00 MAD)
STRIPE_ELEVE_INSCRIPTION_AMOUNT=3900

# Uniquement en NODE_ENV=development : inscription élève sans Stripe (ne pas utiliser en prod)
# Jamais true en production — sinon inscription élève sans carte / sans Paddle.
STRIPE_BYPASS_IN_DEV=false

# CMI (Maroc) — CorrecteurPlus 2.0 ; remplace / complète Stripe selon contrat marchand
# @see src/config/correcteurplus-plans.v2.ts
# CMI_WEBHOOK_SECRET=
# URL publique du webhook (pour tableau de bord CMI)
# CMI_WEBHOOK_PUBLIC_URL=https://correcteurplus.ma/api/webhooks/cmi
# CMI_SUCCESS_URL=https://correcteurplus.ma/fr/apres-connexion?payment=success
# CMI_CANCEL_URL=https://correcteurplus.ma/fr/inscription?payment=cancelled

# Domaine Jitsi pour les salles virtuelles (défaut : meet.jit.si)
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# Next charge les variables depuis ce dossier (web/). Pour OpenAI : obligatoire sauf si vous utilisez Ollama en local.
# Si votre clé est seulement dans un .env à la racine du repo : copiez-la dans web/.env.local OU gardez-la au parent — next.config fusionne ../.env si la variable est vide dans web/.
# Pour utiliser OpenAI quand une clé existe : ne pas définir MATHS_AI_PROVIDER=ollama (sinon Ollama est forcé).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Clé strictement serveur — ne jamais créer de variable NEXT_PUBLIC_* pour OpenAI.
# Modèles (src/lib/ai/config.ts) : économique par défaut, premium seulement si justifié.
# OPENAI_MODEL_ECONOMY=gpt-4o-mini   (repli : OPENAI_MODEL)
# OPENAI_MODEL_PREMIUM=gpt-4o
# AI_ESCALATION_ENABLED=true
# AI_ESCALATE_ON_LOW_CONFIDENCE=true
# AI_ESCALATE_ON_DETAILED=true
# AI_PREMIUM_DAILY_LIMIT=5
# Tokens de sortie max par action
# AI_MAX_TOKENS_CORRECTION=1100
# AI_MAX_TOKENS_DETAILED=1600
# AI_MAX_TOKENS_ASSISTANT=500
# AI_MAX_TOKENS_SIMILAR=700
# AI_MAX_TOKENS_QUIZ=900
# Fichiers (vérifiés avant tout appel API)
# MAX_PDF_PAGES=10
# MAX_DOCUMENT_MB=8
# MAX_IMAGE_MB=5
# MAX_IMAGES_PER_ANALYSIS=5
# AI_IMAGE_DETAIL=high   (low | high | auto)
# Anti-abus
# AI_ANALYSES_PER_MINUTE=6
# AI_ASSISTANT_PER_MINUTE=10
# AI_ASSISTANT_PER_CORRECTION=30
# AI_CORRECTION_CACHE_DAYS=30
# Admin : taux USD → DH pour afficher la « marge avant autres coûts » (sinon non calculée)
# ADMIN_USD_TO_MAD_RATE=

# Aide IA devoirs — OpenAI ou Ollama local
# MATHS_AI_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# fal.ai — Kling Video v3 Pro (text-to-video)
# https://fal.ai/dashboard/keys
# FAL_KEY=
